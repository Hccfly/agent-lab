# 把这个文件复制成 .env,填入你的配置
# Windows: copy .env.example .env

# 必填:你的 OpenAI API Key(以 sk- 开头,官方 key 是 sk- + 48 位,共 51 字符)
# 在 https://platform.openai.com/account/api-keys 查看/重新生成
OPENAI_API_KEY=sk-你的完整key

# 大陆直连 OpenAI 被墙,必须走代理(你的 Clash 端口一般是 7897)
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897

# 可选:换模型
# 如果你是 DeepSeek 网关,可选 deepseek-v4-pro / deepseek-v4-flash / deepseek-v4-flash-vision-exp
# OPENAI_MODEL=deepseek-v4-flash

# 可选:如果你用的是中转/第三方网关(不是官方 api.openai.com),
# 填它的地址,例如 https://xxx.example.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== RAG 记忆(向量检索)配置 =====
# 必填(要用 RAG 时):阿里云百炼 API Key
# 获取: https://bailian.console.aliyun.com/?apiKey=1#/api-key
DASHSCOPE_API_KEY=你的百炼key

# 可选:百炼 OpenAI 兼容端点(默认公共入口,无需改)
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选:embedding 模型
# EMBED_MODEL=text-embedding-v4
